<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <org.mapsforge.map.android.view.MapView
        android:id="@+id/mapView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- ============================================================
         상단 NavigationInfo 영역 (가로 전체)
         좌: 속도계(영역1) | 우: GPS강도+추적상태(영역3/4, 좌우 동일폭)
         그 아래: 주행정보 가로 전체(영역2)
         ============================================================ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginTop="8dp"
        android:layout_marginHorizontal="8dp"
        android:background="#44000000"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"
        android:orientation="vertical">

        <!-- 영역4(빈 방, 추후 배치) + 영역1(속도) + 영역3(GPS강도, 추적상태) 가로 배치 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- 영역4: 추후 사용 예정 (현재 빈 공간) -->
            <LinearLayout
                android:id="@+id/layoutReserved"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="2"
                android:orientation="vertical"
                android:gravity="center" />

            <!-- 영역1: 속도계 (중앙, 가장 크게) -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="6"
                android:orientation="horizontal"
                android:gravity="center">

                <TextView
                    android:id="@+id/tvSpeed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="#FFFFFF"
                    android:textSize="53sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" km/h"
                    android:textColor="#CCCCCC"
                    android:textSize="16sp"
                    android:layout_marginStart="4dp"/>

            </LinearLayout>

            <!-- 영역3: GPS강도 + 추적상태 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="2"
                android:orientation="vertical"
                android:gravity="end">

                <TextView
                    android:id="@+id/tvGpsStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="GPS ○"
                    android:textColor="#AAAAAA"
                    android:textSize="12sp"/>

                <TextView
                    android:id="@+id/tvFollowMode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="추적 ON"
                    android:textColor="#E53935"
                    android:textSize="12sp"
                    android:layout_marginTop="2dp"/>

                <TextView
                    android:id="@+id/tvPauseStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="#FF9800"
                    android:textSize="12sp"
                    android:layout_marginTop="2dp"/>

            </LinearLayout>

        </LinearLayout>

        <!-- 영역2: 주행정보 (가로 전체) — 거리|시간|평균속도 (+경로 있으면 남은거리|진행율) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="4dp">

            <TextView
                android:id="@+id/tvTotalDist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0.0km"
                android:textColor="#FFFFFF"
                android:textSize="25sp"
                android:textStyle="bold"
                android:paddingHorizontal="6dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="|"
                android:textColor="#666666"
                android:textSize="25sp"/>

            <TextView
                android:id="@+id/tvRideTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00"
                android:textColor="#FFFFFF"
                android:textSize="25sp"
                android:textStyle="bold"
                android:paddingHorizontal="6dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="|"
                android:textColor="#666666"
                android:textSize="25sp"/>

            <TextView
                android:id="@+id/tvAvgSpeed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0.0avg"
                android:textColor="#FFFFFF"
                android:textSize="25sp"
                android:textStyle="bold"
                android:paddingHorizontal="6dp"/>

        </LinearLayout>

        <!-- 영역2 확장: 경로 진행 정보 (GPX 우선, 없으면 GraphHopper/NavigationEngine) -->
        <LinearLayout
            android:id="@+id/layoutGpxInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="2dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="|"
                android:textColor="#666666"
                android:textSize="25sp"/>

            <TextView
                android:id="@+id/tvGpxRemain"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="남은 0.0km"
                android:textColor="#FFFFFF"
                android:textSize="25sp"
                android:textStyle="bold"
                android:paddingHorizontal="6dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="|"
                android:textColor="#666666"
                android:textSize="25sp"/>

            <TextView
                android:id="@+id/tvGpxProgress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0%"
                android:textColor="#FFFFFF"
                android:textSize="25sp"
                android:textStyle="bold"
                android:paddingHorizontal="6dp"/>

        </LinearLayout>

        <TextView
            android:id="@+id/tvSpeedComment"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#FFD600"
            android:textSize="17sp"
            android:gravity="center_horizontal"
            android:layout_marginTop="2dp"
            android:layout_gravity="center_horizontal"/>
    </LinearLayout>

    <!-- 경로 이탈 경고 — 새 NavigationInfo 영역과 안 겹치게 마진 확대 -->
    <TextView
        android:id="@+id/tvOffRoute"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="210dp"
        android:background="#CCFF0000"
        android:text="⚠ 경로를 벗어났습니다!"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold"
        android:gravity="center"
        android:paddingVertical="12dp"
        android:visibility="gone"/>
    <TextView
        android:id="@+id/tvMilestone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="270dp"
        android:background="#CC1565C0"
        android:text=""
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold"
        android:gravity="center"
        android:paddingVertical="14dp"
        android:visibility="gone"/>
    <!-- 주행 대기 오버레이 -->
    <LinearLayout
        android:id="@+id/layoutStartOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#AD000014"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="visible">

        <ImageView
            android:layout_width="387dp"
            android:layout_height="205dp"
            android:layout_marginBottom="10dp"
            android:background="@android:color/transparent"
            android:scaleType="fitCenter"
            android:src="@drawable/team_photo2" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="OPPA NAVI"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:textStyle="bold"
            android:letterSpacing="0.15"
            android:layout_marginBottom="6dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="오프라인 자전거 네비"
            android:textColor="#88BBFF"
            android:textSize="12sp"
            android:letterSpacing="0.1"
            android:layout_marginBottom="24dp"/>

        <Button
            android:id="@+id/btnStartRide"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🚴 주행 시작"
            android:textSize="15sp"
            android:textColor="#B2EBD4"
            android:paddingHorizontal="32dp"
            android:paddingVertical="10dp"
            android:backgroundTint="#33A8D8B0"
            android:strokeColor="#A8D8B0"
            android:strokeWidth="2"/>

    </LinearLayout>

    <!-- 우하단 버튼들 -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center|end"
        android:layout_margin="16dp"
        android:orientation="vertical"
        android:gravity="end">

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/btnFinish"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:src="@android:drawable/ic_menu_share"
            android:contentDescription="주행 종료"
            android:visibility="gone"/>

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/btnPause"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:src="@android:drawable/ic_media_pause"
            android:contentDescription="일시정지"
            android:visibility="gone"/>

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/btnClearGpx"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:contentDescription="경로 취소"
            android:visibility="gone"/>

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/btnLoadGpx"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:src="@android:drawable/ic_menu_directions"
            android:contentDescription="GPX 불러오기"
            android:visibility="gone"/>

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/btnMyLocation"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@android:drawable/ic_menu_mylocation"
            android:contentDescription="현재위치"
            android:visibility="gone"/>

    </LinearLayout>

    <!-- ON 블랙박스 PIP Preview — 제거 시 이 블록 삭제 -->
    <FrameLayout
        android:id="@+id/cameraContainer"
        android:layout_width="160dp"
        android:layout_height="120dp"
        android:layout_gravity="bottom|start"
        android:layout_margin="12dp"
        android:background="#000000"
        android:visibility="gone">

        <androidx.camera.view.PreviewView
            android:id="@+id/cameraPreview"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <TextView
            android:id="@+id/tvCameraState"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:padding="2dp"
            android:textSize="8sp"
            android:textColor="#FFFFFF"
            android:background="#88000000"
            android:text="● REC" />
    </FrameLayout>

</FrameLayout>