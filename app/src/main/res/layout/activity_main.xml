<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <org.mapsforge.map.android.view.MapView
        android:id="@+id/mapView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 상단 정보 패널 -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="8dp"
        android:background="#44000000"
        android:paddingHorizontal="20dp"
        android:paddingVertical="6dp"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <!-- 속도 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvSpeed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="#FFFFFF"
                android:textSize="48sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" km/h"
                android:textColor="#CCCCCC"
                android:textSize="16sp"
                android:layout_marginStart="4dp"/>

        </LinearLayout>

        <!-- 주행거리 | 주행시간 | 평균속도 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="2dp">

            <TextView
                android:id="@+id/tvTotalDist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0.0km"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:paddingHorizontal="6dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="|"
                android:textColor="#666666"
                android:textSize="13sp"/>

            <TextView
                android:id="@+id/tvRideTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:paddingHorizontal="6dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="|"
                android:textColor="#666666"
                android:textSize="13sp"/>

            <TextView
                android:id="@+id/tvAvgSpeed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0.0avg"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:paddingHorizontal="6dp"/>

        </LinearLayout>

        <!-- GPX 진행 정보 -->
        <LinearLayout
            android:id="@+id/layoutGpxInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="2dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvGpxProgress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0%"
                android:textColor="#FFD600"
                android:textSize="12sp"
                android:paddingHorizontal="4dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="|"
                android:textColor="#666666"
                android:textSize="12sp"/>

            <TextView
                android:id="@+id/tvGpxRemain"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="남은 0.0km"
                android:textColor="#FFD600"
                android:textSize="12sp"
                android:paddingHorizontal="4dp"/>

        </LinearLayout>

    </LinearLayout>

    <!-- 우상단 GPS/추적 상태 -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="8dp"
        android:background="#44000000"
        android:paddingHorizontal="10dp"
        android:paddingVertical="6dp"
        android:orientation="vertical"
        android:gravity="end">

        <TextView
            android:id="@+id/tvGpsStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="GPS ○"
            android:textColor="#AAAAAA"
            android:textSize="12sp"/>

        <TextView
            android:id="@+id/tvFollowMode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="추적 ON"
            android:textColor="#2F80ED"
            android:textSize="12sp"
            android:layout_marginTop="2dp"/>

        <TextView
            android:id="@+id/tvPauseStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#FF9800"
            android:textSize="12sp"
            android:layout_marginTop="2dp"/>

    </LinearLayout>

    <!-- 경로 이탈 경고 -->
    <TextView
        android:id="@+id/tvOffRoute"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginTop="120dp"
        android:background="#CCFF0000"
        android:text="⚠ 경로를 벗어났습니다!"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold"
        android:gravity="center"
        android:paddingVertical="8dp"
        android:visibility="gone"/>

    <!-- 주행 대기 오버레이 -->
    <LinearLayout
        android:id="@+id/layoutStartOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#88000000"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="visible">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="OppaNavi"
            android:textColor="#FFFFFF"
            android:textSize="32sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="준비됐어? 🚴"
            android:textColor="#CCCCCC"
            android:textSize="18sp"
            android:layout_marginBottom="40dp"/>

        <Button
            android:id="@+id/btnStartRide"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="주행 시작"
            android:textSize="18sp"
            android:paddingHorizontal="32dp"
            android:paddingVertical="12dp"/>

    </LinearLayout>

    <!-- 우하단 버튼들 -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        android:orientation="vertical"
        android:gravity="end">

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/btnFinish"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:src="@android:drawable/ic_menu_share"
            android:contentDescription="주행 종료"
            android:visibility="gone"/>

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/btnPause"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:src="@android:drawable/ic_media_pause"
            android:contentDescription="일시정지"
            android:visibility="gone"/>

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/btnClearGpx"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:contentDescription="경로 취소"
            android:visibility="gone"/>

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/btnLoadGpx"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:src="@android:drawable/ic_menu_directions"
            android:contentDescription="GPX 불러오기"
            android:visibility="gone"/>

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/btnMyLocation"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@android:drawable/ic_menu_mylocation"
            android:contentDescription="현재위치"
            android:visibility="gone"/>

    </LinearLayout>

</FrameLayout>